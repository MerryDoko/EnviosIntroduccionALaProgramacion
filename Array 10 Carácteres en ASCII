#include <stdio.h>

int main() {
    char caracteres[10];
    int letraAscii[10]; 

    printf("Ingrese 10 caracteres:\n");
    for(int i = 0; i < 10; ++i) {
        scanf(" %c", &caracteres[i]); 
    }

    for(int i = 0; i < 10; ++i) {
        letraAscii[i] = (int)caracteres[i];
    }

    printf("\nMOSTRANDO TODOS LOS CARÁCTERES INTRODUCIDOS:\n");
    for(int i = 0; i < 10; ++i) {
        printf("%c ", caracteres[i]);
    }

    printf("\n\nMOSTRANDO LOS VALORES EN CODIGO ASCII:\n");
    for(int i = 0; i < 10; ++i) {
        printf("%d ", letraAscii[i]);
    }

    printf("\n");
    return 0;
}
