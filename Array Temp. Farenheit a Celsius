#include <stdio.h>

int main() {
    
    const char *dias[] = {"Lunes", "Martes", "Miercoles", "Jueves", "Viernes"};
    
    float fahrenheit[5];
    float celsius[5];
    
    //Solicita las 5 temperaturas en Fahrenheit
    printf("Ingrese las 5 temperaturas de la semana en Farenheit:\n");
    for (int i = 0; i < 5; i++) {
        printf("Temperatura del %s (F): \n", dias[i]);
        scanf("%f", &fahrenheit[i]);
    }
    printf("\n");
    
    //Transformar a Celsius y guardar
    for (int i = 0; i < 5; i++) {
        celsius[i] = (fahrenheit[i] - 32.0) * 5.0 / 9.0;
    }
    
    //Mostrar las temperaturas en pantalla
    printf("Resumen temperaturas semanal\n");
    for (int i = 0; i < 5; i++) {
        printf("%s: %.1f F -> %.1f C\n", dias[i], fahrenheit[i], celsius[i]);
    }
    printf("\n");
    
    //Calcular el día más caluroso y el más frío en Celsius
    int dia_max = 0;
    int dia_min = 0;
    
    for (int i = 1; i < 5; i++) {
        if (celsius[i] > celsius[dia_max]) {
            dia_max = i;
        }
        if (celsius[i] < celsius[dia_min]) {
            dia_min = i;
        }
    }
    
    printf("El dia mas caluroso es el %s con %.1f C\n", dias[dia_max], celsius[dia_max]);
    printf("El dia mas frio es el %s con %.1f C\n", dias[dia_min], celsius[dia_min]);
    
    return 0;
}
