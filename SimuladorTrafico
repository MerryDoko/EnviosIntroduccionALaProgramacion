#include <stdio.h>
 
void mostrarMenu() {
    
    //Pues muestra el menú nomanches
    
    printf("===== SIMULADOR DE TRAFICO =====\n");
    printf("1. Activar avenida principal\n");
    printf("2. Activar calle secundaria\n");
    printf("3. Consultar estado del trafico\n");
    printf("4. Avanzar al siguiente ciclo\n");
    printf("5. Finalizar simulacion\n");
    printf("================================\n");
    printf("Ingrese una opcion: ");
}


//dioslibrame de esto 
void activarAvenida(int *espera, int *avanzados, int *tiempo) {
    int llegadas, pasan;
    int capacidad = 20; // Límite de autos que pasan
    int duracion = 40;  // Segundos que dura el semáforo en pasele

    printf("AVENIDA BUENAVISTA \n");
    printf("¿Cuantos carros nuevos llegaron?: ");
    scanf("%d", &llegadas);
    
    if (llegadas > 0) {
        *espera = *espera + llegadas;
    }

    // Aquí se calcula cuantos pasan y cuantos se van a quedar en espera
    if (*espera >= capacidad) {
        pasan = capacidad;
        *espera = *espera - capacidad; // Los que sobran se quedan esperando, resta básica
    } else {
        pasan = *espera;
        *espera = 0; // Pasaron todos los que había, se pone así para que no de negativo de autos
    }

    *avanzados = *avanzados + pasan;
    *tiempo = *tiempo + duracion;

    printf("Semaforo en VERDE. Avanzaron %d vehiculos.\n", pasan);
    printf("Fila de espera actual es de: %d vehiculos.\n", *espera);
}

