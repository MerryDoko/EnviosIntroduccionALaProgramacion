void consultarEstado(int espera_p, int espera_s, int avanzados, int tiempo, int ciclo) {
    printf("--- ESTADO DEL TRAFICO (Ciclo %d/10) ---\n", ciclo);
    printf("Vehiculos esperando (Av. Buenavista): %d\n", espera_p);
    printf("Vehiculos esperando (Av. Kirk): %d\n", espera_s);
    printf("Total de vehiculos que han avanzado: %d\n", avanzados);
    printf("Tiempo total transcurrido: %d segundos\n", tiempo);
    printf("----------------------------------------\n");
}

void mostrarReporte(int avanzados, int espera_p, int espera_s, int tiempo) {
    printf("========================================\n");
    printf("      REPORTE FINAL      \n");
    printf("========================================\n");
    printf("Total de vehiculos que avanzaron: %d\n", avanzados);
    printf("Vehiculos atorados (Av. Buenavista): %d\n", espera_p);
    printf("Vehiculos atorados (Av. Kirk): %d\n", espera_s);
    printf("Tiempo total: %d segundos\n", tiempo);
    printf("========================================\n");
}

int main() {
    int opcion;
    int ciclo = 1; //porque tiene que empezar desde el principio 
    
    // Contadores de los que cuentan , los espera son los que están desde ciclo 0 al iniciard
    int espera_principal = 12;
    int espera_secundaria = 20;
    int total_avanzados = 0;
    int tiempo_total = 0;

    do {
        mostrarMenu();
        scanf("%d", &opcion);

        switch (opcion) {
            case 1:
                activarAvenida(&espera_principal, &total_avanzados, &tiempo_total);
                break;
                
            case 2:
                activarSecundaria(&espera_secundaria, &total_avanzados, &tiempo_total);
                break;
                
            case 3:
                consultarEstado(espera_principal, espera_secundaria, total_avanzados, tiempo_total, ciclo);
                break;
                //estas variables solo consultan info, no modifican, entonces no usamos &, solo las llamamos
                
            case 4:
                if (ciclo >= 10) {
                    printf("Se han completado los 10 ciclos, finalizando\n");
                    opcion = 5;
                } else {
                    ciclo++;
                    printf("Ciclo terminado. Avanzando al ciclo %d/10\n", ciclo);
                }
                break;
                
            case 5:
                printf("Finalizando la simulacion manualmente\n");
                break;
                
            default:
                printf("Opcion no valida. Seleccione un numero del 1 al 5.\n");
                break;
        }

    } while (opcion != 5);
    
    //Muestra el reporte
    mostrarReporte(total_avanzados, espera_principal, espera_secundaria, tiempo_total);

    return 0;
}
