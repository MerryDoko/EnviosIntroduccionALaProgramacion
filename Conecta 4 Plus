#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>

int FILAS = 6;
int COLUMNAS = 7;

// Inicializa el tablero
void inicializarTablero(char tablero[FILAS][COLUMNAS]){
    for(int i = 0; i < FILAS; i++){ 
        for(int j = 0; j < COLUMNAS; j++) {
            tablero[i][j] = '~';
        }
    }
}

// Muestra el tablero con los números de posición
void mostrarTablero(char tablero[FILAS][COLUMNAS]){
    printf("  ");
    for(int j = 0; j < COLUMNAS; j++){
        printf("%d ", j);
    }
    printf("\n");
    for(int i = 0; i < FILAS; i++){
        printf("%d ", i);
        for(int j = 0; j < COLUMNAS; j++) {
            printf("%c ", tablero[i][j]);
        }
        printf("\n");
    }
    printf("\n");
}

// Verificar si alguien ya puso las 4 fichotas
int verificarGanador(char tablero[FILAS][COLUMNAS], char ficha) {
    // Ver. Horizontalmente
    for (int i = 0; i < FILAS; i++) {
        for (int j = 0; j <= COLUMNAS - 4; j++) {
            if (tablero[i][j] == ficha && tablero[i][j+1] == ficha && 
                tablero[i][j+2] == ficha && tablero[i][j+3] == ficha)
                return 1;
        }
    }
    // Verificar Verticalmente
    for (int i = 0; i <= FILAS - 4; i++) {
        for (int j = 0; j < COLUMNAS; j++) {
            if (tablero[i][j] == ficha && tablero[i+1][j] == ficha && 
                tablero[i+2][j] == ficha && tablero[i+3][j] == ficha)
                return 1;
        }
    }
    // Verificar diagonal pa' rriba
    for (int i = 3; i < FILAS; i++) {
        for (int j = 0; j <= COLUMNAS - 4; j++) {
            if (tablero[i][j] == ficha && tablero[i-1][j+1] == ficha && 
                tablero[i-2][j+2] == ficha && tablero[i-3][j+3] == ficha)
                return 1;
        }
    }
    // Verificar Diagonal pa' bajo
    for (int i = 0; i <= FILAS - 4; i++) {
        for (int j = 0; j <= COLUMNAS - 4; j++) {
            if (tablero[i][j] == ficha && tablero[i+1][j+1] == ficha && 
                tablero[i+2][j+2] == ficha && tablero[i+3][j+3] == ficha)
                return 1;
        }
    }
    return 0;
}

// Verifica si el tablero está lleno (empate)
int tableroLleno(char tablero[FILAS][COLUMNAS]) { 
    for (int j = 0; j < COLUMNAS; j++) {
        if (tablero[0][j] == '~') {
            return 0; // Aún hay espacio
        }
    }
    return 1; // Tablero lleno
}

int main(){
    char tablero[FILAS][COLUMNAS];
    inicializarTablero(tablero);

    int turnoJugador1 = 1; // 1 para Jugador 1 (X), 0 para Jugador 2 (O)
    int juegoTerminado = 0;

    // Limpiar pantalla al inicio
    printf("\e[1;1H\e[2J");

    printf("=========================================\n");
    printf("    CONECTA 4 PERO EN C      \n");
    printf("=========================================\n");

    while (!juegoTerminado) {
        mostrarTablero(tablero);

        char fichaActual = turnoJugador1 ? 'X' : 'O';
        int jugadorNum = turnoJugador1 ? 1 : 2;

        printf("-----------------------------------------\n");
        printf("TURNO DE JUGADOR %d (Ficha: %c)\n", jugadorNum, fichaActual);
        printf("Ingresa el número de columna (0 a %d): ", COLUMNAS - 1);
        
        int c;
        if (scanf("%d", &c) != 1) {
            printf("Entrada inválida. Intenta de nuevo.\n");
            while (getchar() != '\n');
            continue;
        }

        // Validar rango columnas
        if (c < 0 || c >= COLUMNAS) {
            printf("Columna fuera de rango. Intenta de nuevo.\n");
            continue;
        }

        // Buscar la fila disponible más baja en esa columna (gravedad)
        int filaAsignada = -1;
        for (int i = FILAS - 1; i >= 0; i--) {
            if (tablero[i][c] == '~') {
                filaAsignada = i;
                break;
            }
        }

        // Si la columna está llena
        if (filaAsignada == -1) {
            printf("La columna %d está llena. Escoge otra.\n", c);
            continue;
        }

        // --- ANIMACIÓN DE LA FICHA CAYENDO ---
        for (int i = 0; i <= filaAsignada; i++) {
            // Colocar la ficha temporalmente en la fila actual de la animación
            tablero[i][c] = fichaActual;

            // Limpiar la pantalla y mover el cursor arriba
            printf("\e[1;1H\e[2J");

            printf("=========================================\n");
            printf("    CONECTA 4 PERO EN C      \n");
            printf("=========================================\n");
            mostrarTablero(tablero);
            printf("-----------------------------------------\n");
            printf("TURNO DE JUGADOR %d (Ficha: %c)\n", jugadorNum, fichaActual);

            // Pausa de 80,000 microsegundos (0.08 segundos) para simular velocidad de caída
            usleep(80000);

            // Si aún no llega a su posición final, borramos la ficha de esta fila para el siguiente cuadro
            if (i < filaAsignada) {
                tablero[i][c] = '~';
            }
        }

        // Comprobar si el jugador actual ganó
        if (verificarGanador(tablero, fichaActual)) {
            printf("\n¡Felicidades Jugador %d! CONECTASTE 4. ¡Tú ganas!\n", jugadorNum);
            juegoTerminado = 1;
            break;
        }

        // Comprobar si hay empate
        if (tableroLleno(tablero)) {
            printf("\nEmpate. El tablero se llenó.\n");
            juegoTerminado = 1;
            break;
        }

        // Cambiar de turno
        turnoJugador1 = !turnoJugador1;
    }

    return 0;
}
